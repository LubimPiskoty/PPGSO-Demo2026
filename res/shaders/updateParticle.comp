#version 430

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// Must match spawnParticle.comp (96 bytes, std430)
struct Particle {
    vec4 color;
    vec4 startColor;
    vec4 endColor;
    vec3 pos;
    float life;
    vec3 velocity;
    float initialLife;
    vec3 accel;
    float _pad0;
    vec2 scale;
    vec2 _pad1;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer FreelistBuffer {
    int count;
    int indices[];
} freelist;

// Layout of DrawArraysIndirectCommand; CPU sets count = 4 (quad vertices)
// and resets instanceCount to 0 every frame before dispatch
layout(std430, binding = 2) buffer IndirectBuffer {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
} indirectCommand;

layout(std430, binding = 3) buffer DrawlistBuffer {
    uint drawIndices[];
};

uniform float u_dt;
uniform vec3 u_viewPos;
uniform vec3 u_forwardDir;
uniform float u_cullingMinAngle; // cos of the max angle from forward; -1 disables culling

void SimulateParticle(uint index) {
    Particle particle = particles[index];
    if (particle.life <= 0.0)
        return;

    particle.pos += particle.velocity * u_dt;
    particle.velocity += particle.accel * u_dt;
    particle.life -= u_dt;

    if (particle.life <= 0.0) {
        particle.color.a = 0.0; // make the particle invisible
        freelist.indices[atomicAdd(freelist.count, 1)] = int(index);
    } else {
        float lifeRatio = particle.life / particle.initialLife;
        particle.color = mix(particle.endColor, particle.startColor, lifeRatio);
        // Shrink during the last 10% of life
        if (particle.life <= particle.initialLife * 0.1) {
            particle.scale = mix(vec2(0), vec2(0.1),
                                 particle.life / (particle.initialLife * 0.1));
        }

        if (dot(u_forwardDir, normalize(particle.pos - u_viewPos)) > u_cullingMinAngle) {
            uint drawIndex = atomicAdd(indirectCommand.instanceCount, 1u);
            drawIndices[drawIndex] = index;
        }
    }

    particles[index] = particle;
}

const uint PARTICLES_PER_THREAD = 128u;

void main() {
    uint globalIndex = gl_GlobalInvocationID.x * PARTICLES_PER_THREAD;
    for (uint i = 0u; i < PARTICLES_PER_THREAD; i++) {
        uint index = globalIndex + i;
        if (index >= uint(particles.length()))
            return;
        SimulateParticle(index);
    }
}
